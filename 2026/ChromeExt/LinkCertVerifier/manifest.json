{
  "manifest_version": 3,
  "name": "LinkCertVerifier - リンクアドレス・TLS証明書検証",
  "version": "1.0.0",
  "description": "右クリックメニュー「リンクのアドレスを検証」でリンク先URLの安全性・DNS解決・TLS証明書チェーンをページ遷移せずに検証表示します",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "result.html?mode=popup",
    "default_title": "リンクアドレス・TLS証明書を検証"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
