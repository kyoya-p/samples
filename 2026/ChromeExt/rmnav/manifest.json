{
  "manifest_version": 3,
  "name": "Redmine Graph Navigator (rmnav)",
  "version": "2.0.0",
  "description": "現在開いているRedmineページ（チケット詳細・一覧・ガントチャート等）から関連チケットのリンク関係をVis.jsでグラフ表示・探索します。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Redmine Graph Navigator を開く (Alt+Shift+R)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Redmine Graph Navigator を起動"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
