{
  "manifest_version": 3,
  "name": "Claude Usage Panel",
  "version": "1.1.0",
  "description": "Claude Code の /usage をバックグラウンド定期採取し、既存ページ上のドロワーで5時間枠・週次残量推移とモデル別トークン使用量を可視化",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Claude Usage Panel ドロワーを開く/閉じる (Alt+Shift+C)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["styles.js", "panel_core.js", "drawer.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Claude Usage Panel ドロワーの開閉"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
