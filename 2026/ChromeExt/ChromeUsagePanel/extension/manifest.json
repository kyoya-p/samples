{
  "manifest_version": 3,
  "name": "AI Usage Panel (Claude Code & Antigravity)",
  "version": "1.0.0",
  "description": "Claude Code と Antigravity の /usage をバックグラウンド定期採取し、5時間枠・週次残量推移とモデル別トークン使用量を可視化するダッシュボード",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AI Usage Panel を開く"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
